{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "Bash(gh api:*)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/guard/branch-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}